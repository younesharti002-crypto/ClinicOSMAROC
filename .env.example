DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-secret"

# Configured only when connecting a real clinic to Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN="replace-at-live-integration-time"
WHATSAPP_APP_SECRET="replace-at-live-integration-time"
WHATSAPP_VERIFY_TOKEN="replace-at-live-integration-time"
WHATSAPP_GRAPH_VERSION="vXX.X"

# Protects the internal reminder scheduler endpoint.
CRON_SECRET="replace-with-a-long-random-secret"
