DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-secret"

# One-time clinic/admin bootstrap values. Use only in the terminal/session that
# runs `npm run bootstrap:admin`; do not keep real passwords in committed files.
BOOTSTRAP_CLINIC_NAME="Cabinet Exemple"
BOOTSTRAP_CLINIC_SLUG="cabinet-exemple"
BOOTSTRAP_CLINIC_PHONE="+212522000000"
BOOTSTRAP_CLINIC_ADDRESS="Casablanca"
BOOTSTRAP_CLINIC_CITY="Casablanca"
BOOTSTRAP_CLINIC_INPE=""
BOOTSTRAP_ADMIN_EMAIL="admin@example.ma"
BOOTSTRAP_ADMIN_NAME="Dr Admin"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-password"
BOOTSTRAP_ADMIN_PHONE=""
BOOTSTRAP_ADMIN_INPE=""

# Configured only when connecting a real clinic to Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN="replace-at-live-integration-time"
WHATSAPP_APP_SECRET="replace-at-live-integration-time"
WHATSAPP_VERIFY_TOKEN="replace-at-live-integration-time"
WHATSAPP_GRAPH_VERSION="vXX.X"

# Protects the internal reminder scheduler endpoint.
CRON_SECRET="replace-with-a-long-random-secret"
